DATABASE_URL=postgres://app_rw:app_rw_dev_only@127.0.0.1:5433/vaultside?sslmode=disable
DATABASE_URL_ADMIN=postgres://vaultside:vaultside@127.0.0.1:5433/vaultside?sslmode=disable
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vaultside-dev
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
SMTP_HOST=localhost
SMTP_PORT=1025
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
SESSION_SECRET=dev-only-change-me
DEV_AUTH=trueAWS_EC2_METADATA_DISABLED=true
SSO_SECRET_KEY=base64-encoded-32-bytes
SAML_CERT_B64=base64-encoded-pem-cert
SAML_KEY_B64=base64-encoded-pem-key

# AI assist and transcription. Both default to "noop" so the app runs
# without external calls. Set to "anthropic" or "openai" for assist and
# "whisper" or "deepgram" for transcribe, then supply the matching key.
ASSIST_PROVIDER=noop
ASSIST_API_KEY=
ASSIST_MODEL=claude-sonnet-4-5
TRANSCRIBE_PROVIDER=noop
TRANSCRIBE_API_KEY=